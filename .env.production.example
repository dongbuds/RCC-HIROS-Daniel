# ═══════════════════════════════════════════════════════════════
# RCC-HIROS — production environment (Daniel's deployment)
# Copy to the host, outside the checkout:
#   cp .env.production.example ~/rcc-hiros-daniel-deploy/.env.production
# Generate secrets with:
#   openssl rand -base64 48     # JWT_SECRET
#   openssl rand -hex 24        # database passwords (URL-safe)
# ═══════════════════════════════════════════════════════════════

# ── Application ──
# Inside compose the database host is the service name `db`.
# The password here must match MARIADB_PASSWORD below.
DATABASE_URL="mysql://hiros:CHANGE_ME_DB_PASSWORD@db:3306/rcc_hiros"
JWT_SECRET="CHANGE_ME_RANDOM_48_BYTES"
TZ="Asia/Manila"

# Server-side address of the ZK bridge. In Docker, the Windows host.
KIOSK_SERVICE_URL="http://host.docker.internal:8765"

# Optional comma-separated allowlist of public IPs allowed to reach the
# unauthenticated kiosk endpoints (/api/biometric/zk/*). Empty = allow all,
# which is fine for a demo. Set it to the school's egress IP in production.
KIOSK_ALLOWED_IPS=""

# Browser-side address, baked into the client bundle at build time.
# Kiosk browsers run on the machine with the scanner, so loopback is correct.
NEXT_PUBLIC_KIOSK_SERVICE_URL="http://127.0.0.1:8765"

# ── Database (mariadb:11.4 image) ──
MARIADB_ROOT_PASSWORD="CHANGE_ME_ROOT_PASSWORD"
MARIADB_DATABASE="rcc_hiros"
MARIADB_USER="hiros"
MARIADB_PASSWORD="CHANGE_ME_DB_PASSWORD"

# ── Cloudflare Tunnel (profile: tunnel) ──
# Zero Trust → Networks → Tunnels → create → connector token.
CLOUDFLARE_TUNNEL_TOKEN=""

# ── Optional overrides ──
# The deploy job appends these after a successful deploy; they pin the
# exact image that is running so a manual restart cannot drift.
# APP_IMAGE="ghcr.io/dongbuds/rcc-hiros-daniel:<git-sha>"
# MIGRATE_IMAGE="ghcr.io/dongbuds/rcc-hiros-daniel:migrate"
